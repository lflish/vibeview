# deploy-view 部署目标。复制为 local.env 后填写；local.env 已被 .gitignore 忽略，不要提交。
# 也可以直接在环境变量里设置，环境变量优先于本文件。

# 空 = 部署到本机；否则是 SSH 目标（~/.ssh/config 里的别名，或 user@host）
VIEW_DEPLOY_HOST=
# 目标机上的服务目录（与开发仓库分开）
VIEW_DEPLOY_DIR=/home/<user>/vibeview-prod
# 发布备份目录，缺省为服务目录旁的 vibeview-releases/
VIEW_RELEASES_DIR=
# 对外 HTTPS 地址
VIEW_PUBLIC_URL=https://view.example.com
# 主服务和 render sidecar 在目标机上的本地端口
VIEW_MAIN_PORT=3000
VIEW_RENDER_PORT=3001
# 主服务由谁守护：systemd-user（systemctl --user）或 pm2
VIEW_SERVICE_MANAGER=systemd-user
VIEW_SERVICE_NAME=vibeview
